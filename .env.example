# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=

# Domain pack: prompts, routing signals, UI copy, sources and evaluation set.
# In Docker Compose this is overridden to /packs/eu-ai-act.
# PACK_DIR=packs/eu-ai-act

# Models.
# CHAT_MODEL answers users and writes document summaries.
# UTILITY_MODEL handles routing and query condensing: small, frequent,
# latency-sensitive calls.
# AGENT_MODEL is used on the tool-using document navigation path.
# CHAT_MODEL=gpt-5.4-mini
# UTILITY_MODEL=gpt-5.4-mini
# AGENT_MODEL=gpt-5.4-mini

# Embeddings.
# EMBED_DIM must match EMBED_MODEL's output width and the pgvector column size.
# Changing either after ingesting data requires rebuilding the database schema
# and re-ingesting the corpus.
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=1536              # must match EMBED_MODEL's output width

# Retrieval.
# TOP_K is the number of chunks sent to the fast RAG path.
# RRF_POOL is the candidate pool per retriever before reciprocal-rank fusion.
# PER_DOC_CAP limits chunks per document in the selected context; 0 disables it.
# MAX_CHUNK_TOKENS controls ingestion-time chunk size.
# TOP_K=16
# RRF_POOL=80
# PER_DOC_CAP=0
# MAX_CHUNK_TOKENS=512

# Agent path.
# AGENT_MAX_TOOL_CALLS is the soft cap; after it tools ask the model to conclude.
# AGENT_HARD_CAP_EXTRA is the extra budget before the graph forces conclusion.
# AGENT_TIMEOUT_S is the wall-clock limit for tool use.
# AGENT_MAX_TOOL_CALLS=12
# AGENT_HARD_CAP_EXTRA=4
# AGENT_TIMEOUT_S=150

# Data locations.
# Docker Compose overrides these to /data/... inside containers. Set them in
# .env only when running backend/ingestion directly on the host or using a
# custom layout.
# RAW_DIR=data/raw
# OBJECTS_DIR=data/objects
# WORKSPACE_DIR=data/workspace
# MANIFEST_PATH=data/manifest.json

# Ingestion.
# Disable only if OCR dependencies are unavailable or scanned PDFs are out of
# scope for your corpus.
# INGEST_OCR=true

# Comma-separated origins allowed to call the API from a browser.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local host default. Docker Compose overrides this to the service hostname.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/knowledge_base

# Used by benchmark/run.py when --backend-url is omitted.
# EVAL_BACKEND_URL=http://localhost:8000/api/chat
