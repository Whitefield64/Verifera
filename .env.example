# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=

# Which domain pack to load: prompts, routing signals, UI copy, evaluation set.
# PACK_DIR=packs/eu-ai-act

# Models. chat_model answers users and writes document summaries; utility_model
# handles routing and query condensing — small, frequent, latency-sensitive.
# CHAT_MODEL=gpt-5.4-mini
# UTILITY_MODEL=gpt-5.4-mini
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=1536              # must match EMBED_MODEL's output width

# Agent path
# AGENT_MODEL=gpt-5.4-mini
# AGENT_ESCALATION_MODEL=gpt-5.5     # only for structured/tabular lookups
# AGENT_MAX_TOOL_CALLS=12
# AGENT_TIMEOUT_S=150

# Retrieval
# TOP_K=12
# PER_DOC_CAP=3

# Comma-separated origins allowed to call the API from a browser.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/knowledge_base

# Used by benchmark/run.py when --backend-url is omitted.
# EVAL_BACKEND_URL=http://localhost:8000/api/chat
