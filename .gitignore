# Secrets and local configuration
.env
.env.*
!.env.example
*.key
*.pem

# Operating systems
.DS_Store
Thumbs.db

# Editors and IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# JavaScript / TypeScript
node_modules/
.next/
engine/frontend/public/pdf.worker.min.mjs
dist/
build/
coverage/

# Logs, caches and temporary files
*.log
logs/
.cache/
tmp/
temp/
.playwright-mcp/

# AI coding tools (local-only configuration). AGENTS.md is the opposite: it is
# written for whoever clones this, and is tracked.
.claude/settings.local.json
.claude/**/.venv/
.codex/
.agents/
CLAUDE.md
.claude/

# Personal working notes and reviews: never published.
docs/interno/
PROJECT_REVIEW.md

# Local assistant configuration. `make example` copies the demo config in here,
# and your own identity.md lives here too. The engine has a default for every
# one of these files, so an empty config/ is a working system.
config/*
!config/.gitkeep

# Everything under data/ is regenerable: documents are re-fetched or re-copied
# into data/raw and `make ingest` rebuilds the rest. The directories themselves
# are tracked so a fresh clone has somewhere to put documents.
data/raw/*
data/objects/*
data/workspace/*
data/eval-runs/*
!data/*/.gitkeep
